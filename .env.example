# ====================================================================
# MEDDECK - Environment Configuration (.env)
# ====================================================================

# --- OPTION 1: Ollama (100% local, free, no internet required) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2

# --- OPTION 2: Official OpenAI API ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- OPTION 3: Groq (free tier, very fast) ---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.1-8b-instant

# --- OPTION 4: OpenRouter ---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Web server port (optional; defaults to 5000)
PORT=5000

# Flask session secret key (REQUIRED on Vercel: the filesystem is read-only and a
# generated secret would change on every cold start, logging everyone out).
MEDDECK_SECRET_KEY=

# Set to 1 when serving over HTTPS (Vercel/Render/production) so session cookies
# are marked Secure.
MEDDECK_HTTPS=0

# Where the SQLite database and secret file live. Leave empty to use ./instance.
# On read-only hosts such as Vercel the app automatically falls back to the
# system temp directory; set this only if you want an explicit location.
MEDDECK_DATA_DIR=
