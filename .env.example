# ====================================================================
# MEDDECK - Environment Configuration (.env)
# ====================================================================

# --- OPTION 1: Ollama (100% local, free, no internet required) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2

# --- OPTION 2: Official OpenAI API ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- OPTION 3: Groq (free tier, very fast) ---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.1-8b-instant

# --- OPTION 4: OpenRouter ---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Web server port (optional; defaults to 5000)
PORT=5000

# Flask session secret key (optional)
MEDDECK_SECRET_KEY=
