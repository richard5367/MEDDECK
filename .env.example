# ====================================================================
# MEDDECK - Environment Configuration (.env)
# ====================================================================
# This file is git-ignored and is NEVER deployed. It only affects local runs
# (python meddeck.py or .\run_meddeck.ps1).
# For Vercel you must copy the variables into
# Settings -> Environment Variables in the dashboard. See the sections below.
# ====================================================================


# ####################################################################
# LOCAL DEVELOPMENT - default block
# ####################################################################
# Ollama: 100% local, free, no internet required.
# The key value is ignored by Ollama's OpenAI-compatible API, but it must be
# present and non-empty, otherwise the app disables the AI feature entirely.
#
# Do NOT copy this block into Vercel. There is no Ollama server on Vercel, and
# "localhost" there means Vercel's own container, so every AI request would
# fail with a URLError while the UI still claims the AI is configured.

OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2

# Web server port (optional; defaults to 5000)
PORT=5000


# ####################################################################
# VERCEL DEPLOYMENT - copy these into the dashboard
# ####################################################################
# 1) Flask session secret key - REQUIRED on Vercel.
#    The filesystem there is read-only, so a generated secret would change on
#    every cold start and log every user out. Generate one with:
#        python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDDECK_SECRET_KEY=

# 2) Set to 1 when serving over HTTPS (Vercel/Render/production) so that
#    session cookies are marked Secure.
MEDDECK_HTTPS=1

# 3) AI provider - pick ONE cloud block below and paste its three variables
#    into Vercel. Serverless hosts cannot reach a model running on your laptop,
#    so the local Ollama block above does not work here.
#
#    a) Groq (free tier, very fast; recommended for a demo)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.1-8b-instant
#
#    b) OpenRouter (free model available; larger catalogue)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free
#
#    c) Official OpenAI API (paid)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
#    Leave all three unset if you do not need the AI feature in the
#    deployment: the app then shows "AI is not configured" and keeps working.
#
# 4) Optional. Where the SQLite database and secret file live. Leave empty to
#    use ./instance. On read-only hosts such as Vercel the app automatically
#    falls back to the system temp directory, so this is rarely needed.
MEDDECK_DATA_DIR=


# ####################################################################
# OPTIONAL - local HPO datasets
# ####################################################################
# phenotype.hpoa, hp.obo and genes_to_phenotype.txt are expected in your
# Downloads folder, or you can point at them explicitly. These files are not
# deployed to Vercel, so disease scoring, the Atlas and candidate genes stay
# empty there unless you bundle the data.
# HPOA_PATH=
# HPO_OBO_PATH=
# HPO_GENE_PATH=